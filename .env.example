# ── docker-compose: postgres container ────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── ASP.NET Core runtime + dotnet ef (__ = config section separator) ──────────
# Export these into your shell before `dotnet run` / `dotnet ef`:
#   export $(grep -v '^#' .env | grep '__' | xargs)
#   export $(grep -v '^#' .env | grep '^AllowedHosts=' | xargs)
# The first line picks up ConnectionStrings__* and Jwt__*. AllowedHosts is a
# top-level ASP.NET key (no __), so it needs the second line.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>
Jwt__SigningKey=
Jwt__ExpiresMinutes=

# Host header allow-list (semicolon-separated). Dev default; set your real domain(s) in prod.
AllowedHosts=localhost;127.0.0.1
